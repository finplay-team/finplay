# 필요한 환경변수 목록. 실제 값은 .env(gitignore됨)에 복사해 채우거나 셸/CI 시크릿으로 주입한다.
# 이 파일에는 절대 실제 값을 적지 않는다 (conventions.md 시크릿 규칙).

# --- 인증 (PRD 태스크 2에서 사용) ---
# 32바이트 이상 랜덤 문자열. 생성 예: openssl rand -base64 48
# 로컬 포함 모든 환경에서 환경변수로만 주입한다 — yml에 기본값을 두지 않는다 (튜터 피드백 2026-07-24).
JWT_SECRET=

# 카카오/네이버 OAuth. 실키가 없으면 Fake OAuth 프로필로 실행한다 (PRD AUTH-003).
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=
# OAuth state 쿠키의 Secure 속성. 운영·실제 OAuth는 true, local HTTP 테스트만 false로 명시한다.
OAUTH_STATE_COOKIE_SECURE=
# OAuth state 서명(HMAC-SHA-256)용. 32바이트 이상 랜덤. JWT_SECRET과 반드시 다른 값을 쓴다.
OAUTH_STATE_SECRET=
# 로그인 callback 성공 시 리다이렉트할 프론트 콜백 주소. 브라우저가 카카오·네이버 인가 후 직접 이 API로
# 넘어오므로(redirect_uri가 API 주소), 토큰을 여기로 다시 실어 보내야 프론트가 로그인 상태를 받을 수 있다.
# 실제 토큰은 쿼리에 없다 — 1회용 교환 코드만 붙는다. 예: https://www.finplay.site/oauth/callback
OAUTH_LOGIN_REDIRECT_URI=

# --- 이메일 인증 (PRD AUTH-004) ---
# 인증번호 HMAC-SHA-256용. 32바이트 이상 랜덤. JWT_SECRET과 반드시 다른 값을 쓴다.
# 로컬·테스트에서도 인증번호 저장에 쓰이므로 채워두는 것을 권장한다.
EMAIL_VERIFICATION_SECRET=

# --- 비밀번호 재설정 (PRD AUTH-006) ---
# 재설정 인증번호 HMAC-SHA-256용. 32바이트 이상 랜덤. EMAIL_VERIFICATION_SECRET과 반드시 다른 값을 쓴다.
PASSWORD_RESET_SECRET=

# --- 이메일 발송 (운영 프로필에서만 필요) ---
# 로컬·테스트는 FakeEmailSender를 쓰므로 아래 두 값이 비어 있어도 앱과 테스트가 정상 기동한다.
# Resend에 인증된 발신 서브도메인이 필요하다 (DNS는 팀 Route 53에서 관리 — docs/specs/010-deployment).
RESEND_API_KEY=
EMAIL_FROM=

# --- 한국투자증권(KIS) Open API 키 (MKT-005) ---
# 과거 분봉 수집 배치(KisHistoricalCandleCollector)가 사용 — 없어도 기동·빌드는 성공하며,
# 없으면 수집이 실패해 그날 재생세션이 FAILED가 될 뿐이다.
# 실제 값은 서버 환경변수 또는 AWS Secret에만 둔다 — 브라우저·코드·문서·GitHub 금지.
KIS_APP_KEY=
KIS_APP_SECRET=

# --- 뉴스·공시 수집과 AI 서술 (spec 012 FEED-001) ---
# 네 개 전부 없어도 기동·./gradlew build·자동 테스트는 정상이다. 없을 때 무슨 일이 일어나는지만 다르다.
#
# 아래 수집 키 2종은 환경에 따라 "없을 때"의 모양이 다르다. 수집기 선택을 키 유무가 아니라 스프링 프로필이
# 가르기 때문이다 — 로컬·테스트(비-prod)는 Fake 수집기가 등록돼 외부 호출을 아예 하지 않고, 이 파일을 실제로
# 읽는 배포(prod)에는 Fake가 등록되지 않고 실제 수집기가 뜬다.
# 그래서 배포에서 키를 비워 두면 "Fake가 빈 목록을 준다"가 아니라 "호출이 401로 실패해 그 종목만 건너뛴다"가
# 된다. 수집 결과가 0건인 것은 같지만, 30분마다 전 종목이 실패하며 WARN 로그가 쌓인다.
#
# 로컬에서 실제 기사를 받아 보려면 news-real 프로필을 켠다 (이슈 #273 — crypto-real·oauth-real과 같은 방식).
#     SPRING_PROFILES_ACTIVE=local,news-real ./gradlew bootRun
# 켜면 NaverNewsCollector가 아래 키로 실제 네이버 검색을 호출한다. 안 켜면(기본) 키가 채워져 있어도
# FakeNewsCollector가 빈 목록을 주므로 **기사가 한 건도 쌓이지 않는다** — 그 0건은 오류가 아니라 계약대로
# summaryStatus="EMPTY"로 나가서 화면상 아무 신호가 없다. 이것을 코인 수집 결함으로 오인한 것이 이슈 #273이다.
# 공시(DART)는 이 프로필로 바뀌지 않는다 — 로컬 공시는 여전히 FakeDisclosureCollector다.
#
# 네이버 뉴스 검색 API. 위 NAVER_CLIENT_ID/SECRET(OAuth 로그인)과 **별개 애플리케이션**의 키다 —
# 로그인용 값을 여기 재사용하면 검색과 로그인 중 하나가 조용히 깨진다.
# 없으면 기사가 한 건도 쌓이지 않고, 근거 0건이라 변동 원인 카드가 생성되지 않으며 뉴스 요약·개장 전
# 브리핑이 빈다.
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
# OpenDART 공시검색 API 키. 없으면 공시가 한 건도 쌓이지 않아 공시 없이 뉴스만으로 진행한다.
DART_API_KEY=
# OpenAI API 키(application.yml의 spring.ai.openai.api-key가 읽는다). 없으면 자리표시자로 기동하고
# LLM 호출을 하지 않는다 — 카드·매도 회고는 템플릿 문장, 요약·브리핑은 서술 없음으로 폴백한다.
OPENAI_API_KEY=

# --- 배포(prod 프로필)에서만 필요. 로컬은 spring-boot-docker-compose가 자동 구성 ---
# 배포의 DB·캐시는 EC2 안 컨테이너가 아니라 관리형 서비스다 (ADR-0020, 이슈 #326).
# compose.deploy.yaml에는 mysql·redis 서비스가 없으므로 아래 값을 compose가 덮어쓰지 않는다 —
# 여기(정확히는 서버의 .env) 값이 그대로 앱에 들어간다. 비거나 틀리면 기동에 실패한다.
#
# RDS 엔드포인트를 적는다. 예: jdbc:mysql://<rds-endpoint>:3306/finplay?useSSL=false&...
DB_URL=
# RDS 마스터 사용자 또는 앱 전용 계정. root 계정을 쓰지 않는다.
DB_USERNAME=
DB_PASSWORD=
# ElastiCache 기본(primary) 엔드포인트. prod 프로필은 기본값 없이 참조하므로 비어 있으면 기동에 실패한다 (이슈 #125).
REDIS_HOST=
REDIS_PORT=
# ElastiCache의 "전송 중 암호화"를 켠 클러스터에 붙으려면 반드시 true여야 한다.
# 빠뜨리면 DNS·보안그룹·TCP가 전부 정상인데 Lettuce만
# RedisCommandTimeoutException: Connection initialization timed out after 2 second(s)로 실패한다
# (2026-08-11 실측) — 서버는 TLS 핸드셰이크를 요구하는데 클라이언트가 평문으로 붙기 때문이다.
# 네트워크 문제로 오진하기 쉬우니 접속 실패 시 이 값부터 확인한다.
# 로컬(컨테이너 redis)은 암호화가 없으므로 비워 둔다.
SPRING_DATA_REDIS_SSL_ENABLED=
# 커뮤니티 첨부 이미지를 저장할 S3 버킷 이름(이슈 #330). 버킷은 코드가 아니라 AWS 콘솔에서
# 미리 만들어야 한다(퍼블릭 액세스 차단 유지, deploy/README.md 체크리스트 참고). 시크릿이 아니지만
# prod 프로필은 기본값 없이 참조하므로 비어 있으면 기동에 실패한다. 자격 증명·리전은 EC2 IAM
# 인스턴스 프로파일과 AWS_REGION 표준 환경변수에 맡긴다 — 여기 정적 액세스 키를 추가하지 않는다.
COMMUNITY_S3_BUCKET=

# 브라우저가 API를 호출하도록 허용할 프론트 오리진. 콤마로 여러 개(ADR-0022).
# 프론트가 S3로 분리되면서 프론트와 API의 오리진이 갈라져 CORS가 필요해졌다. prod 프로필은 기본값
# 없이 참조하므로 비어 있으면 기동에 실패한다 — 값이 틀렸을 때 앱은 멀쩡히 뜨고 브라우저에서만
# 전 API가 막히는 형태라 기동 시점에 잡는 편이 낫다.
# 스킴+호스트(+포트)까지만 적는다. 경로나 끝 슬래시를 붙이면 기동 시 예외로 거부된다.
#   A 단계(S3 단독): http://finplay-frontend.s3-website.ap-northeast-2.amazonaws.com
#   B 단계(CloudFront): https://www.finplay.site
#   전환기에는 둘을 콤마로 함께 둔다 — 이 값이 환경변수라 A→B 전환에 코드 배포가 필요 없다.
CORS_ALLOWED_ORIGINS=

# --- CD 파이프라인 전용 (ADR-0021) ---
# 아래 3개는 파이프라인이 배포 시점에 EC2의 .env에 써 넣는 값이다. 사람이 직접 채우지 않는다 —
# 로컬 개발·수동 배포(compose.deploy.yaml)는 이 값을 쓰지 않는다.
# color별로 변수를 나눈 이유: 하나로 합치면 EC2 재부팅 시 두 색 모두 최신 태그로 다시 뜨게 되어
# "직전 색으로 롤백"이 무엇으로 돌아가는지 특정할 수 없어진다 (ADR-0021 §맥락과 같은 문제).
ECR_REGISTRY=
APP_IMAGE_BLUE=
APP_IMAGE_GREEN=

# --- 로컬 코인 실데이터 (이슈 #107) ---
# 여기만 환경변수가 아니라 스프링 프로필 이야기다. 켜는 데 새 시크릿은 필요 없다 —
# 빗썸 공개 REST는 인증·API Key 없이 호출되므로 아래에 추가할 키가 없다.
# 기본 상태(프로필 OFF)의 코인 값은 전부 더미다. 현재가는 시뮬레이터가 10만~1000만 사이에서
# 고른 랜덤 시작값이 흔들리는 합성 틱이고, 코인 분봉은 항상 빈 배열이다.
# 그럴듯한 숫자가 보여도 실제 시세가 아니다 — 시세로 읽고 판단하지 마라.
# (실제 사례: 합성 분봉 시드가 삼성전자를 7만원대로 표시해 실제 종가 208,500원과 혼동을 일으켰다.)
# 실제 빗썸 시세로 보려면 crypto-real 프로필을 켠다. 코인 분봉과 현재가가 함께 실데이터로 바뀐다.
# Spring Boot는 .env를 읽지 않고 bootRun은 어떤 프로필도 기본 활성화하지 않으므로,
# 셸에서 .env를 먼저 로드하고 local까지 직접 지정한다.
#   set -a; . ./.env; set +a
#   SPRING_PROFILES_ACTIVE=local,crypto-real ./gradlew bootRun
# 자동 테스트는 이 프로필을 켜지 않는다 (PRD C-005 — 외부 네트워크 의존 금지).
